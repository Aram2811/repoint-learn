# --- Database ---
DATABASE_URL="postgresql://repoint:repoint_dev_pass@localhost:5432/repoint_dev?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- JWT Auth ---
# با openssl rand -base64 64 یک مقدار تصادفی و امن بساز (در پروداکشن حتماً عوضش کن)
JWT_ACCESS_SECRET="change-me-in-production-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- SMS / OTP Provider ---
# فعلاً Mock هست (در کنسول لاگ می‌شه). وقتی اکانت واقعی (مثلاً Kavenegar) داشتی این‌ها رو پر کن.
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_NUMBER=""

# --- Object Storage (Video/Media) ---
# فعلاً Mock/Local هست. بعداً با Cloudflare R2 واقعی جایگزین می‌شه.
STORAGE_PROVIDER="local"
STORAGE_BUCKET="repoint-media"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
